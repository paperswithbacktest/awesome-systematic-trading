research/experiments/**/cache/
research/experiments/**/figures/*.png
!research/experiments/**/figures/.gitkeep
research/**/*.parquet
research/**/*.h5
research/**/*.feather

# Archive: keep scripts/metrics/reports/hashes; drop raw bars & plots
research/archive/**/data/
research/archive/**/cache/
research/archive/**/data_*.csv
research/archive/**/prices.csv
research/archive/**/btc_usd_daily.csv
research/archive/**/btc_usd_hourly*.csv
research/archive/**/*.png

